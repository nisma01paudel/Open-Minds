__pycache__/
*.pyc
.venv/
venv/
data/
# ...but NOT the web app's own data. The map fetches /data/timeline.json, /data/terrain.bin and
# the slopes geojson at runtime; ignoring these left a clone with an empty map and no terrain.
!web/public/data/
cache/
.env
*.tif
*.tiff
*.nc
.ipynb_checkpoints/
.DS_Store

# Web app: dependencies and build output are reproducible from the lockfile
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts

# Generated video: large, and reproducible from scripts/build_video.sh
reports/video/clips/
reports/video/stills/
reports/video/*.mp4
reports/timelapse/frames/

# Generated narration audio (reproducible; also large)
reports/video/voice*/

# Generated media. These were committed BEFORE this rule existed, so .gitignore alone did
# not stop them - they stayed tracked and put 353 MB into the repository, which every
# judge then had to clone. Untracked and purged from history separately.
# The film and its narration source ARE the submission (deliverable 4), so they are tracked.
# The build inputs - stills, per-beat clips, voice wavs - are regenerable and stay ignored.
reports/video/*
!reports/video/pahiro-narrated-web.mp4
!reports/video/voice/
reports/video/voice/*
!reports/video/voice/narration.txt
reports/timelapse/frames/
# Flutter
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins-dependencies

# Voice models are ~63 MB each and are fetched, not committed. This repo was once bloated to
# 353 MB by committing generated artifacts; the model is a dependency, not source.
evidence/voices/
*.onnx
*.onnx.json
